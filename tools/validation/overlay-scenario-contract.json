{
  "contract": "overlay-scenario-contract/v1",
  "tracker": "v1.1.md",
  "updated": "2026-05-23",
  "purpose": "Parseable matrix for overlay-specific screenshot, replay, and cross-surface parity scenarios. This is the planning contract for what each overlay must prove across browser review, localhost/OBS, Windows native, compact replay fixtures, and optional full-capture replay.",
  "productDescriptor": {
    "source": "src/TmrOverlay.Core/Overlays/OverlayBehaviorDescriptorCatalog.cs",
    "validatedBy": ["tests/TmrOverlay.App.Tests/Overlays/OverlayBehaviorDescriptorContractTests.cs"],
    "matchKey": "overlays[].id",
    "relationship": "The app does not consume this JSON. App-owned overlay behavior descriptors define stable product policy; this contract references and tests against those descriptors so screenshot and replay coverage stays aligned."
  },
  "statusValues": {
    "covered": "The scenario has deterministic validation in the named tier and surfaces.",
    "partial": "Some validation exists, but it is missing a surface, a semantic assertion, replay evidence, or a known edge case.",
    "missing": "The scenario is known needed and has no durable validation yet.",
    "not_applicable": "The scenario does not apply to this overlay or surface."
  },
  "surfaces": {
    "browserReview": "Generated browser-review route and screenshot manifest.",
    "localhostObs": "Production localhost/OBS route and screenshot manifest.",
    "windowsNative": "Windows native screenshot artifact and manifest where the overlay exists natively.",
    "settingsUi": "Settings app page/component screenshot and uiEvidence manifest.",
    "compactReplay": "Small committed capture-derived frame/model summary replayed through production logic.",
    "fullCaptureReplay": "Optional/nightly explicit raw capture replay, not required in fast PR CI."
  },
  "tiers": [
    {
      "id": "tier1-ci-contract-fixtures",
      "name": "Tier 1 - CI Contract Fixtures",
      "cadence": "every PR",
      "artifactPolicy": "commit small deterministic fixtures and generated manifests; do not commit full raw capture folders",
      "requiredScenarioFamilies": [
        "populated",
        "no-data-or-unavailable",
        "chrome-on-no-data-where-applicable",
        "chrome-off-where-applicable",
        "session-modes",
        "content-toggles",
        "minimum-scale",
        "localhost-route-and-aliases"
      ],
      "requiredAssertions": [
        "visible-or-hidden state",
        "row, column, section, marker, flag, or message counts",
        "required visible text and forbidden stale/misleading text",
        "data/source/provenance labels",
        "width, height, crop, body, and content bounds",
        "settings hash parity where a surface can drift"
      ]
    },
    {
      "id": "tier2-capture-derived-replay",
      "name": "Tier 2 - Capture-Derived Replay Fixtures",
      "cadence": "PR for compact fixtures after a bug is understood; optional local for broader windows",
      "artifactPolicy": "commit tiny capture-derived frame/model summaries; keep full capture-* directories out of required CI",
      "requiredScenarioFamilies": [
        "real-data-window",
        "production-model-replay",
        "browser-localhost-render-replay",
        "semantic-manifest"
      ],
      "requiredAssertions": [
        "raw telemetry fields explain the selected frame/window",
        "production model output matches the intended product behavior",
        "rendered screenshot manifest matches the model",
        "known issue is either reproduced or explicitly classified as not present in the selected window"
      ]
    },
    {
      "id": "tier3-release-native-parity",
      "name": "Tier 3 - Release / Native Parity Gate",
      "cadence": "release, pre-release, or heavier CI gate",
      "artifactPolicy": "generate Windows native screenshots/manifests and compare them with browser review and localhost artifacts",
      "requiredScenarioFamilies": [
        "cross-surface-manifest-parity",
        "windows-native-pixel-evidence",
        "shared-geometry-contract-drift",
        "release-blocking-compact-replay"
      ],
      "requiredAssertions": [
        "browser review, localhost/OBS, and Windows native agree on semantic state for the same data/settings",
        "geometry and image size match exactly or within documented overlay-specific tolerance",
        "native unsupported surfaces are explicitly declared",
        "full raw-capture replay remains optional/nightly unless promoted to a compact fixture"
      ]
    }
  ],
  "globalRequirements": [
    {
      "id": "same-data-and-settings",
      "description": "Parity scenarios must identify the exact fixture, capture-derived frame/model summary, preview mode, enabled content, chrome state, scale, opacity, and route alias used by each surface."
    },
    {
      "id": "semantic-before-pixels",
      "description": "Screenshots should validate pixels after model/evidence contracts prove that the model is meaningful. Row identity, source labels, unavailable policy, and forbidden stale content are first-class assertions."
    },
    {
      "id": "chrome-on-no-data-policy",
      "description": "Every overlay must explicitly declare whether enabled header/footer chrome can render without body data. Stable chrome-only waiting states and true no-render states must both be validated where applicable."
    },
    {
      "id": "minimum-scale-means-scale",
      "description": "At 60% scale, product content should scale visually. It must not silently hide columns, rows, markers, graph content, or chrome unless a separate content setting disables them."
    },
    {
      "id": "obs-readiness-classification",
      "description": "Telemetry-rich captures must classify each expected OBS overlay as not-requested, page-loaded-no-model, model-polled-hidden, model-rendered, or browser-source-error."
    }
  ],
