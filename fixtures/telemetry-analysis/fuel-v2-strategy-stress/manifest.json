{
  "schemaVersion": 1,
  "purpose": "Fuel Calculator V2 characterization catalogue. Each named case is a reusable input/expectation contract for Core tests, browser workbench review, and eventual localhost/OBS and Windows-native overlay evidence. It deliberately separates capture-derived facts from constructed policy pressure tests.",
  "sourcePolicy": {
    "runtimeAuthority": "Normalized live telemetry remains runtime authority. Compact history and raw capture slices are evidence inputs, not precomputed runtime advice.",
    "provenanceRule": "A constructed case may exercise a real arithmetic or policy boundary, but it must never be labelled capture-derived. A V1 summary reference is not importable Fuel V2 history.",
    "privacyRule": "Capture IDs are sanctioned opaque archive locators and may encode a capture time. Only those locators, sanitized session-clock/frame boundaries, and retained quantitative evidence appear here; raw telemetry, local paths, and personal/team identities remain outside the fixture.",
    "archiveAvailability": "Named raw captures are local archive inputs, not CI fixtures, until a compact redacted semantic slice is checked in. Each raw source states its current availability."
  },
  "consumerContract": {
    "core": "Use inputMode=direct-core cases for deterministic selector, route, checkpoint, scheduler, and lifecycle characterization tests. Raw-replay cases first need a compact semantic export; do not hand-copy raw telemetry into a test.",
    "workbench": "Render only the normalized inputs plus expected state. Show captured, history-reference, and constructed provenance distinctly.",
    "finalOverlay": "Turn each eligible case into browser-review, localhost/OBS, and Windows-native evidence only after the real V2 presenter owns the relevant row. Hidden/degraded states are first-class expected results.",
    "exportKey": "The case id is the stable non-identifying key for a future compact semantic exporter; it must not use the local capture path."
  },
  "coverageDefault": {
    "core": "planned",
    "workbench": "planned",
    "browser": "planned",
    "localhost": "planned",
    "native": "planned"
  },
  "cases": [
